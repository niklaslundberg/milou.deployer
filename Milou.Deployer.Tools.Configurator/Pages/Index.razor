@page "/counter"
@using System.Collections.Immutable
@using Arbor.KVConfiguration.Schema.Json

<h1>Generate deployer configuration</h1>

<EditForm Model="@_configurationModel" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator/>
    <ValidationSummary/>

    <InputText id="martenConnectionString" @bind-Value="_configurationModel.MartenConnectionString"/>

    <button type="submit">Submit</button>
</EditForm>

<textarea style="height: 500px; width: 1000px;">@_serialized</textarea>

@code {
    private readonly ConfigurationModel _configurationModel = new();

    private string _serialized;

    private void HandleValidSubmit()
    {
        var keys = new List<KeyValue> {new("urn:milou:deployer:web:marten:singleton:connection-string", _configurationModel.MartenConnectionString, null)}.ToImmutableArray();
        ConfigurationItems configurationItems = new("1.0", keys);
        _serialized = JsonConfigurationSerializer.Serialize(configurationItems);
    }

}