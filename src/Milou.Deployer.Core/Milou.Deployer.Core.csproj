<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Arbor.AppModel" Version="0.13.0" />
    <PackageReference Include="Arbor.KVConfiguration.Core" Version="2.4.0" />
    <PackageReference Include="Arbor.KVConfiguration.Schema.Json" Version="2.4.0" />
    <PackageReference Include="Arbor.KVConfiguration.Urns" Version="2.4.0" />
    <PackageReference Include="Arbor.Processing" Version="*" />
    <PackageReference Include="Arbor.Tooler" Version="0.19.0" />
    <PackageReference Include="MediatR" Version="10.0.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.*" />
    <PackageReference Include="Microsoft.Web.Xdt" Version="*" />
    <PackageReference Include="JetBrains.Annotations" Version="2022.3.1" />
    <PackageReference Include="Microsoft.Extensions.Primitives" Version="7.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="*" />
    <PackageReference Include="NuGet.Configuration" Version="6.*" />
    <PackageReference Include="NuGet.Packaging" Version="6.*" />
    <PackageReference Include="NuGet.Protocol" Version="6.*" />
    <PackageReference Include="NuGet.Versioning" Version="6.*" />
    <PackageReference Include="Serilog" Version="*" />
    <PackageReference Include="System.Collections.Immutable" Version="7.0.0" />
    <PackageReference Include="Arbor.ModelBinding.Primitives" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
    <_Parameter1>Milou.Deployer.Tests.Integration</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)\GeneratedFiles</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

</Project>